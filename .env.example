# Пример переменных окружения для mvp-manager.
# Скопируйте в .env при необходимости и загрузите в shell — приложение
# читает только os.Getenv, файл .env само не подхватывает:
#
#   set -a && source .env && set +a
#
# docker compose подставляет переменные из .env (и defaults из compose)
# для credentials Postgres — без хардкода, расходящегося с DSN.

# Идентификатор ноды агента (обязателен). Один и тот же NODE_ID у agent, ctl,
# bot-runner и healthcheck в локальном E2E. У control-api — нода по умолчанию
# для assigned_node_id при create. Сиды Phase PG привязаны к node-1.
NODE_ID=node-1

# Тип хранилища: memory | postgres
# По умолчанию в example — postgres (Phase PG). Memory e2e-скрипты задают
# STORE=memory явно. Без source .env Go DefaultStore остаётся memory.
STORE=postgres

# Общий JSON-файл для STORE=memory: agent, ctl, bot-runner, healthcheck и control-api
# должны указывать один путь. Если переменную не задавать —
# используется .mvp-manager/store.json. Пустая строка MEMORY_STORE_PATH=
# отключает файл (только RAM текущего процесса).
MEMORY_STORE_PATH=.mvp-manager/store.json

# --- Phase PG: PostgreSQL ---
# 1) docker compose up -d
# 2) go run ./cmd/migrate up          # схема в POSTGRES_DB (dev)
# 3) go run ./cmd/migrate seed        # ручные сиды только в dev
# 4) ./bin/agent                      # STORE=postgres из .env
#
# E2E использует другую БД в том же контейнере (не schema):
#   go run ./cmd/migrate --e2e up
#   ./scripts/e2e-phase-pg.sh
#
# Credentials Docker / DSN должны совпадать:
# при смене POSTGRES_USER / PASSWORD / HOST / PORT / DB — обновите и
# DATABASE_URL / DATABASE_URL_E2E (compose читает POSTGRES_*; приложение — DSN).
POSTGRES_USER=mvp
POSTGRES_PASSWORD=mvp
POSTGRES_DB=mvp_manager
POSTGRES_DB_E2E=mvp_manager_e2e
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

DATABASE_URL=postgres://mvp:mvp@127.0.0.1:5432/mvp_manager?sslmode=disable
DATABASE_URL_E2E=postgres://mvp:mvp@127.0.0.1:5432/mvp_manager_e2e?sslmode=disable

# При STORE=postgres agent поднимает LISTEN/NOTIFY (ChangeWatcher) + poll.

# Команда запуска multi-tenant bot-runner (агент стартует через supervisor).
# Обычно абсолютный путь к собранному бинарнику.
BOT_RUNNER_COMMAND=./bin/bot-runner
# BOT_RUNNER_WORKDIR=
# Служебный /healthz самого процесса runner (опционально).
# BOT_RUNNER_HEALTH_PORT=19000

# Lease на runtime (Phase 3): TTL после Acquire/Renew. Старт процесса только
# при успешном lease текущим NODE_ID.
LEASE_TTL=15s

# Интервалы агента (time.ParseDuration: 3s, 500ms, …).
RECONCILE_INTERVAL=3s
HEARTBEAT_INTERVAL=5s
SHUTDOWN_GRACE=10s

# --- Phase 4: restart / limits ---
# Сколько авто-рестартов после crash/unhealthy (0 = выкл.).
RESTART_MAX_ATTEMPTS=5
# Начальная пауза и потолок экспоненциального backoff.
RESTART_BACKOFF_BASE=1s
RESTART_BACKOFF_MAX=60s
# Лимит ботов на ноду (assigned_node_id); 0 = без лимита.
MAX_BOTS_PER_NODE=0

# Healthcheck (отдельный процесс; интервал независим от reconcile).
CHECK_INTERVAL=10s
HTTP_TIMEOUT=2s
FAILURE_THRESHOLD=3
# HEALTHCHECK_ALL_NODES=false

# control-api (Phase 3): HTTP API над тем же store.
# API_ADDR=127.0.0.1:8080
# CONTROL_API_TOKEN=replace-with-secret

# Токен по умолчанию для `ctl bots create`, если не передан --token.
# BOT_TOKEN=replace-me

# --- token_ref (bots.token_ref) ---
# Предпочтительно ссылка на ENV (полный токен не светится в list/API):
#   env:MY_BOT_TOKEN   → os.Getenv("MY_BOT_TOKEN")
#   $MY_BOT_TOKEN      → то же
# Plaintext в MVP ещё допустим, но ctl/API маскируют его в выводе и варнят в лог.
# Пример для живого Telegram (polling):
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# затем: ctl bots create --type default --token 'env:TELEGRAM_BOT_TOKEN' --mode polling …
#
# Max (channel=max): нужен access_token бота с https://dev.max.ru;
# API: https://platform-api2.max.ru (Authorization header).

# Опционально: PUBLIC_URL для исходящего setWebhook у Telegram/Max.
# Без публичного HTTPS runner всё равно принимает POST /webhook на порту бота
# (best effort / локальные тесты); для production webhook нужен PUBLIC_URL + регистрация.
# PUBLIC_URL=https://example.com
