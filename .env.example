# Пример переменных окружения для mvp-manager (Phase 1).
# Скопируйте в .env при необходимости и загрузите в shell — приложение
# читает только os.Getenv, файл .env само не подхватывает:
#
#   set -a && source .env && set +a
#
# Docker / реальный Postgres на этом этапе не нужны.

# Идентификатор ноды агента (обязателен). Один и тот же NODE_ID у agent и ctl
# в локальном E2E (assigned_node_id при bots create берётся из NODE_ID).
NODE_ID=node-1

# Тип хранилища: memory (по умолчанию) | postgres (Phase PG).
STORE=memory

# Общий JSON-файл для STORE=memory: agent и ctl должны указывать один путь,
# иначе не видят записи друг друга. Если переменную не задавать —
# используется .mvp-manager/store.json. Пустая строка MEMORY_STORE_PATH=
# отключает файл (только RAM текущего процесса).
MEMORY_STORE_PATH=.mvp-manager/store.json

# Интервалы агента (time.ParseDuration: 3s, 500ms, …).
RECONCILE_INTERVAL=3s
HEARTBEAT_INTERVAL=5s
SHUTDOWN_GRACE=10s

# Опционально: PUBLIC_URL для launch contract webhook-ботов.
# PUBLIC_URL=https://example.com

# Токен по умолчанию для `ctl bots create`, если не передан --token.
# BOT_TOKEN=replace-me

# --- Phase PG (позже; сейчас можно не задавать) ---
# STORE=postgres
# DATABASE_URL=postgres://user:pass@localhost:5432/mvp_manager?sslmode=disable
