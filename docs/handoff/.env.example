# Пример ENV для single-bot (handoff клиенту).
# Скопируйте в .env рядом с бинарником бота:
#   set -a && source .env && set +a
#
# Это launch contract ТЗ §9 — те же переменные, что менеджер
# прокидывает в custom-процесс / сценарий default.

PORT=18080
BOT_TOKEN=replace-me
BOT_MODE=webhook
CHANNEL=telegram

# Опционально: публичный HTTPS для регистрации webhook у мессенджера.
# PUBLIC_URL=https://bot.example.com
